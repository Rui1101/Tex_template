% =====================================================================
%  references.bib : 卒論と梗概で共通の文献データ
% =====================================================================
%
% ■ 使い方
%   1. 下の記入例から近い種類のものをコピーして、中身を書き換える。
%   2. 本文で \cite{引用キー} と書くと、参考文献欄に載る。
%      番号は、本文で初めて引用した順に自動で付く。
%   3. ここに書いても \cite していない文献は、参考文献欄に出ない。
%      （使わない記入例は残したままで問題ない）
%
% ■ 引用キー（1行目の { の直後の名前）
%   ・半角英数字で、文献ごとに重複しない名前にする。
%   ・おすすめは「第1著者の姓＋年」。例: yamada2025, cortes1995
%   ・同じ人・同じ年が重なったら yamada2025a, yamada2025b のようにする。
%
% ■ 種類（先頭の アットマーク のあとの名前）
%   article        学術雑誌・論文誌の論文
%   inproceedings  学会・研究会・シンポジウムの論文（予稿）
%   book           本
%   mastersthesis  卒業論文・修士論文（type で種類を書く）
%   misc           Web ページなど、上に当てはまらないもの
%
% ■ 書き方のルール
%   ・著者が複数のときは and でつなぐ。カンマや「，」でつながない。
%       和文: {山田 太郎 and 鈴木 花子}（姓と名の間は半角スペース）
%       英文: {Cortes, Corinna and Vapnik, Vladimir}（姓, 名 の順）
%   ・ページは 273--297 のようにハイフンを2つ続ける。
%   ・タイトル中の英単語は先頭以外が小文字に変わる。大文字を残したい語は {} で囲む。
%     例: {Wi-Fi} を用いた {RSSI} の測定
%   ・URL などに _ や % や & があるときは \_ \% \& と書く。
%   ・各行の最後に , を付ける（最後の行は付けなくてもよい）。
%   ・この説明のような行の中では アットマーク記号を使わないこと
%     （BibTeX が文献の始まりとみなしてエラーになる）。
%
% =====================================================================


% ---- 英文の論文誌（article） ----
@article{cortes1995,
  author  = {Cortes, Corinna and Vapnik, Vladimir},
  title   = {Support-vector networks},
  journal = {Machine Learning},
  year    = {1995},
  volume  = {20},
  number  = {3},
  pages   = {273--297},
  doi     = {10.1007/BF00994018}
}

% ---- 和文の学会・研究会の論文（inproceedings） ----
@inproceedings{yamada2025,
  author    = {山田 太郎 and 鈴木 花子},
  title     = {サンプル論文のタイトル：和文の会議論文の書き方},
  booktitle = {○○シンポジウム論文集},
  year      = {2025},
  pages     = {1--6}
}

% ---- 和文の論文誌（article） ----
@article{tanaka2024,
  author  = {田中 一郎 and 佐藤 次郎 and 高橋 三郎},
  title   = {サンプル論文のタイトル：和文の論文誌の書き方},
  journal = {○○学会論文誌},
  year    = {2024},
  volume  = {65},
  number  = {3},
  pages   = {100--110}
}

% ---- 本（book） ----
@book{sato2023,
  author    = {佐藤 花子},
  title     = {サンプルの本のタイトル},
  publisher = {○○出版},
  year      = {2023}
}

% ---- 卒業論文・修士論文（mastersthesis） ----
@mastersthesis{suzuki2024,
  author = {鈴木 四郎},
  title  = {サンプルの卒業論文のタイトル},
  type   = {卒業論文},
  school = {○○大学○○学部○○学科},
  year   = {2024}
}

% ---- Web ページ（misc） ----
@misc{example2026web,
  author       = {○○株式会社},
  title        = {サンプルの {Web} ページのタイトル},
  howpublished = {https://www.example.com/sample\_page},
  note         = {（参照日：2026年11月27日）},
  year         = {2026}
}
